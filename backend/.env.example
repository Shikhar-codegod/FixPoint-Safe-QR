# FixPoint Drive – Safe-QR SOS Backend Environment Configuration
# Django Configuration
DJANGO_SECRET_KEY=change-this-insecure-key-in-production-fixpoint-drive-sos-secret-9941
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=fixpoint_backend.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in production; SQLite fallback in local development if unset)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fixpoint_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=True

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Field-Level Encryption Key (Fernet 32 url-safe base64-encoded bytes)
# Generate a new key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER commit real encryption keys to version control.
FIELD_ENCRYPTION_KEY=YOUR_32_URLSAFE_BASE64_FERNET_KEY_HERE=

# Notification Delivery Settings
# Always "mock" unless explicitly configured with external telecom adapters
NOTIFICATION_PROVIDER_MODE=mock
NOTIFICATION_WHATSAPP_WAIT_SECONDS=60
NOTIFICATION_SMS_TO_CALL_DELAY_SECONDS=30
NOTIFICATION_CALL_RETRY_LIMIT=1
NOTIFICATION_PENDING_STALE_SECONDS=20
MOCK_FAIL_CHANNELS=

# Real Provider Adapter Skeleton Configuration (Unconfigured by default)
# REAL_WHATSAPP_API_TOKEN=
# REAL_WHATSAPP_PHONE_NUMBER_ID=
# REAL_SMS_AUTH_TOKEN=
# REAL_SMS_ACCOUNT_SID=
# REAL_VOICE_API_KEY=
# REAL_VOICE_ACCOUNT_ID=
