# FixPoint Drive – Safe-QR SOS Backend Environment Configuration
# Django Configuration
DJANGO_SECRET_KEY=change-this-insecure-key-in-production-fixpoint-drive-sos-secret-9941
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=fixpoint_backend.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in production; SQLite fallback in local development if unset)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fixpoint_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Field-Level Encryption Key (Fernet 32 url-safe base64-encoded bytes)
# Run `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
FIELD_ENCRYPTION_KEY=-dH3bVNkLyz65qi4aCC9qxXJaUpe1947ZbGFpIM0E3s=
